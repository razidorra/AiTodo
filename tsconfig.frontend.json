{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["public/**/*.ts", "public/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
